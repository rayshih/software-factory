# Copy to .env for local dev. Never commit real values.
# Tests do not read this file.

# GitHub App "Forgeline" (https://github.com/settings/apps). App ID, not the client ID.
GITHUB_APP_ID=

# Base64 of the App's PEM private key (single line, no wrapping whitespace).
#   base64 -w 0 < forgeline.pem
GITHUB_APP_PRIVATE_KEY_B64=

# Shared secret for X-Hub-Signature-256. Set the same value on the GitHub App webhook.
GITHUB_WEBHOOK_SECRET=

# Postgres connection string. Neon, Render Postgres, or Fly Postgres all work.
DATABASE_URL=postgres://software_factory:software_factory@localhost:5432/software_factory

# Trigger.dev project. The secret authenticates tasks.trigger and the worker.
# The project ref is the proj_... value from the Trigger.dev project settings.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=proj_replace_me

# Anthropic Console key with access to Claude Managed Agents (beta).
# When unset, the worker uses StubAgentRuntime and will not modify the target repo.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-6.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional. Reuse one cloud environment instead of creating one per session.
ANTHROPIC_ENVIRONMENT_ID=

# Optional. Abort a managed-agent stream after this many milliseconds (default 1200000).
AGENT_SESSION_TIMEOUT_MS=1200000

# Comma-separated owner/repo list. Unset means rayshih/sf-demo-todo-api only.
# An empty value allowlists nothing.
ALLOWED_REPOS=rayshih/sf-demo-todo-api

# Issue label that starts a run.
TRIGGER_LABEL=factory:run

# Branch the factory PR targets.
BASE_BRANCH=main

# HTTP port. Render and Fly set PORT for you.
PORT=3000
